# Ignore everything in the repository root by default
/*

# Keep root-level project files
!/.gitignore
!/README.md
!/environment.yml

# Keep selected top-level directories
!/data/
!/feature/
!/model/
!/figures/

# Data: ignore everything except the selected example assay
/data/*
!/data/1M+_to_1M+/
/data/1M+_to_1M+/*
!/data/1M+_to_1M+/epistasis_2_Abundance_Faure_2024/

# Model: ignore everything except training scripts and source modules
/model/*
!/model/train*.py
!/model/joint_train*.py
!/model/e2e_train*.py
!/model/cerebra_epistasis/
!/model/utils/

# Python cache and compiled files
**/__pycache__/
*.pyc